# NUNCA COMITEAR CREDENCIALES REALES EN ESTE ARCHIVO
# Este archivo es para referencia de variables requeridas

# Database Configuration
# Formato: mysql+mysqldb://usuario:contraseña@host:puerto/base_datos
DATABASE_URL=mysql+mysqldb://user:password@host:port/database

# ⚠️ SEGURIDAD CRÍTICA: Generar claves fuertes
# Generar SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Mínimo 32 caracteres, aleatorio y único
SECRET_KEY=GENERAR_CON_COMANDO_ARRIBA_MIN_32_CARACTERES

# ⚠️ SEGURIDAD CRÍTICA: Token de admin
# Generar ADMIN_TOKEN: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NUNCA usar "default-token", siempre generar uno fuerte
ADMIN_TOKEN=GENERAR_CON_COMANDO_ARRIBA_MIN_32_CARACTERES

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Frontend Origins (CORS)
# Especificar dominios exactos, NUNCA "*"
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# Usar contraseña de aplicación, NO la contraseña de la cuenta
SMTP_PASSWORD=your-app-specific-password

# Cloudinary Configuration (Opcional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Environment
ENVIRONMENT=production
DEBUG=False

# Rate Limiting
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_BAN_MINUTES=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# API Server
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=False  # NUNCA True en producción
